# Copy to .streamlit/secrets.toml for local runs (never commit the real file).
# On Streamlit Community Cloud paste the same lines into App settings → Secrets.
GEMINI_API_KEY = "paste-your-key-here"
GEMINI_MODEL = "gemini-3.1-flash-lite"
# Tried automatically if the main model is busy/over quota. Set to "" to disable.
GEMINI_FALLBACK_MODEL = "gemini-3.5-flash-lite"
# Link shown as the official source in answers and fallbacks.
AMFI_LINK = "https://www.amfiindia.com"
# If set, the eval page asks for this before running (protects your quota on the public app).
EVAL_PASSCODE = "choose-a-passcode"
